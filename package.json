{
  "name": "bookscapm",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@sap/xssec": "^4.13.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.0",
    "mbt": "^1.2.29",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-bookscapmui": "cds watch --open bookscapmui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy bookscapm --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "private": true,
  "cds": {
    "sql": {
      "native_hana_associations": false
    },
    "requires": {
      "auth": {
        "[production]": {
          "strategy": "JWT"
        },
        "[development]": {
          "strategy": "mocked",
          "users": {
            "suman": {
              "password": "welcome3",
              "roles": [
                "Admin"
              ]
            },
            "kid1": {
              "password": "welcome5",
              "roles": [
                "Kids"
              ],
              "userAttributes": {
                "bookAgeGroup": [
                  "KIDS"
                ]
              }
            }
          }
        }
      },
      "[production]": {
        "db": "hana"
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/bookscapmui"
  ]
}